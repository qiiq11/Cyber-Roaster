# ==== 应用基础 ====
DEBUG=false

# ==== LLM（OpenAI 兼容 API）====
# 支持硅基流动 / Azure OpenAI / DeepSeek 等，任选其一
#
# 【如何获取 API Key】
# 1) 硅基流动（SiliconFlow）：https://cloud.siliconflow.cn → 控制台 → API 密钥
#    填入示例：OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
#    模型可继续用默认的 deepseek-ai/DeepSeek-V3
# 2) DeepSeek 官方：https://platform.deepseek.com → API Keys
#    需同时改 BASE_URL 与 MODEL：
#      OPENAI_BASE_URL=https://api.deepseek.com
#      OPENAI_MODEL=deepseek-chat
#
# 注意：本文件仅为模板。复制为 .env 后再填入真实密钥，切勿把密钥提交到仓库。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL=deepseek-ai/DeepSeek-V3

# ==== GitHub 集成 ====
GITHUB_TOKEN=
WEBHOOK_SECRET=

# ==== 数据库 ====
# 开发默认 SQLite；生产可改为 PostgreSQL 连接串
DATABASE_URL=sqlite:///./cyber_roaster.db

# ==== 梗图输出目录 ====
MEME_OUTPUT_DIR=./static/memes
